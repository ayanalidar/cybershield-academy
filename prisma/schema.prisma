generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          String    @default("student")
  avatarUrl     String?
  bio           String?
  xp            Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  lastActiveAt  DateTime  @default(now())
  enrolledIn    Enrollment[]
  interactionHistory InteractionHistory[]
  telemetryLogs TelemetryLog[]
  labSessions   LabSession[]
  performanceMetrics PerformanceMetrics[]
  certificates  Certificate[]
  quizAttempts  QuizAttempt[]
  notifications  Notification[]
  xpLog         XpLog[]
  userBadges    UserBadge[]
  ctfSubmissions CtfSubmission[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String?
  category      String       @default("cybersecurity")
  thumbnailUrl  String?
  difficulty    String       @default("intermediate")
  durationHours Float        @default(0)
  rating        Float        @default(0)
  studentCount  Int          @default(0)
  isPublished   Boolean      @default(true)
  modules       Module[]
  enrollments   Enrollment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([difficulty])
}

model Module {
  id            String     @id @default(cuid())
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  content       String
  contentType   String     @default("markdown")
  orderIndex    Int        @default(0)
  durationMinutes Int      @default(30)
  isPublished   Boolean    @default(false)
  videoUrl      String?
  labConfig     String?
  quiz          Quiz[]
  embeddings    Embedding[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([courseId, orderIndex])
}

model Quiz {
  id            String       @id @default(cuid())
  moduleId      String
  module        Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  timeLimitSec  Int          @default(300)
  passingScore  Float        @default(0.7)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]
  createdAt     DateTime     @default(now())

  @@index([moduleId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  questionType  String   @default("multiple_choice")
  options       String
  correctAnswer String
  explanation   String?
  points        Float    @default(1)
  orderIndex    Int      @default(0)

  @@index([quizId])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       String
  score         Float
  maxScore      Float
  passed        Boolean  @default(false)
  timeTakenSec  Int
  createdAt     DateTime @default(now())

  @@index([userId, quizId])
}

model Embedding {
  id        String  @id @default(cuid())
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content   String
  vector    String
  createdAt DateTime @default(now())

  @@index([moduleId])
}

model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          String    @default("active")
  currentModuleId String?
  overallProgress Float     @default(0)
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model TelemetryLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String
  eventType   String
  eventValue  String?
  durationMs  Int?
  focusScore  Float?
  pageUrl     String?
  moduleContext String?
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
  @@index([sessionId])
}

model InteractionHistory {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId          String?
  sessionId         String
  interactionType   String
  content           String
  aiResponse        String?
  comprehensionScore Float?
  timestamp         DateTime @default(now())

  @@index([userId, timestamp])
  @@index([sessionId])
}

model LabSession {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId          String?
  containerId       String
  containerName     String
  status            String   @default("starting")
  topic             String
  objectives        String
  commandHistory    String?
  objectivesCompleted String?
  score             Float?
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  terminatedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PerformanceMetrics {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  moduleId              String?
  sessionId             String?
  quizAccuracy          Float    @default(0)
  comprehensionScore    Float    @default(0)
  averageFocusScore     Float    @default(0)
  labCompletionRate     Float    @default(0)
  interactionCount      Int      @default(0)
  timeSpentMinutes      Float    @default(0)
  strengths             String?
  weaknesses            String?
  recommendations       String?
  recordedAt            DateTime @default(now())

  @@index([userId, courseId])
  @@index([recordedAt])
}

model Certificate {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  courseName      String
  userName        String
  verificationHash String
  status          String    @default("active")
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  @@unique([verificationHash])
  @@index([userId])
  @@index([verificationHash])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model XpLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Badge {
  id          String     @id @default(cuid())
  name        String
  description String
  icon        String
  category    String     @default("achievement")
  xpReward    Int        @default(50)
  rarity      String     @default("common")
  userBadges  UserBadge[]

  @@unique([name])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model CtfChallenge {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String
  difficulty    String   @default("medium")
  points        Int      @default(100)
  hint          String?
  flag          String
  solveCount    Int      @default(0)
  isPublished   Boolean  @default(true)
  submissions   CtfSubmission[]
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([difficulty])
}

model CtfSubmission {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  flagSubmitted String
  correct     Boolean      @default(false)
  submittedAt DateTime     @default(now())

  @@index([userId, challengeId])
}